# apps/server/.local.env — server-specific env for the local stage.
# Same file structure applies to .dev.env / .prod.env (synced to GitHub
# Secrets via `pnpm sync:secrets`). See docs/deploy.md.
#
# Control-plane secrets (CLOUDFLARE_API_TOKEN, CLOUDFLARE_EMAIL,
# ALCHEMY_STATE_TOKEN) live in `.alchemy.env` at the repo root, NOT here.

# ─── Custom domains (optional; zone must be on Cloudflare DNS) ───
# Only honored for stages `dev` and `prod`. PR previews (`pr-<N>`) always
# use the auto-generated *.workers.dev URL.
# WEB_DOMAIN=app.example.com
# SERVER_DOMAIN=api.example.com

# ─── R2 storage (optional) ───
# Enables R2 storage routes (presigned uploads, list, delete). Without
# both keys set, R2 bindings are skipped and storage routes error.
# Create at: https://dash.cloudflare.com/?to=/:account/r2/overview
#   → Manage R2 API tokens → Object Read & Write scope
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
