# apps/server/.local.env - server runtime env. One file per stage, same keys in
# For credential-free verification use root `pnpm dev:local` instead.
# That command uses wrangler.local.jsonc and ignores this file. Its D1/KV/R2
# are local emulators; S3 presigned uploads still require remote R2 credentials.
# each. Copy this example to whichever you need:
#
#   .local.env   `pnpm dev` on your machine (stage `local`)
#   .dev.env     stage `dev`  - deployed on push to the `dev` branch.
#                Also reused as-is by PR preview stages (`pr-<N>`).
#   .prod.env    stage `prod` - deployed on push to the `main` branch.
#
# `.local.env` is needed BEFORE the first run:
#
#   cp apps/server/.local.env.example apps/server/.local.env
#
# `pnpm dev` passes `--env-file .local.env` and dies if the file is missing.
# An empty file is fine - every value below has a working local default.
#
#   FOO=      fill this in
#   # FOO=    optional
#
# `.dev.env` / `.prod.env` are uploaded to GitHub Secrets by `pnpm sync:secrets`
# and written back by CI at deploy time. `.local.env` never leaves your machine.
#
# Control-plane credentials (CLOUDFLARE_API_TOKEN, ALCHEMY_STATE_TOKEN) live in
# `.alchemy.env` at the repo root, not here.

# ---------------------------------------------------------------------------
# Custom domains
# ---------------------------------------------------------------------------
#
# Each app reads these from its OWN env file - alchemy runs once per app with a
# separate `--env-file`, and nothing is shared between the two runs. Whatever
# you set here must also be set in `apps/web/.{stage}.env`.

# Frontend custom domain. On the server side this is NOT the server's own
# hostname: it builds CORS_ORIGIN, which becomes the R2 bucket's CORS allow-list.
#
# Optional. PR previews always ignore it; the local stage hardcodes localhost.
# On dev/prod, unset means the auto-issued workers.dev URL.
# WEB_DOMAIN=app.example.com

# Backend custom domain - the server Worker binds to it.
# Optional, same stage rules as WEB_DOMAIN above.
# SERVER_DOMAIN=api.example.com

# ---------------------------------------------------------------------------
# Auth (docs/auth.md)
# ---------------------------------------------------------------------------

# The single auth switch.
#
# - open        provisioned active users may sign in; public signup is disabled.
# - admin-only  provisioned active users may sign in; same operational allowlist.
# - disabled    sign-in is turned off; protected routes return 401.
#
# Unset means `open` locally and `disabled` on deployed stages, so a fresh fork
# deploys safely with zero configuration. An invalid value fails the deploy.
# Initialize an approved admin offline after migrations. Local-only helper:
# node scripts/bootstrap-admin.ts admin@example.test --local
# Manage subsequent emails, activation and permissions through /cases/users.
# ADMIN_EMAILS is retained for starter deployment compatibility; it no longer
# grants privileges or creates accounts during runtime login.
#
# On dev/prod, `open` and `admin-only` REQUIRE all four of BETTER_AUTH_SECRET,
# RESEND_API_KEY, EMAIL_FROM and ADMIN_EMAILS - the deploy fails closed without
# them. PR previews skip this check.
# AUTH_MODE=open

# Secret used to sign auth sessions. Part of the AUTH_MODE fail-closed set.
# A local default is built in, so `pnpm dev` needs nothing here.
#
# Generate: openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Legacy starter deployment metadata (still validated by deployment tooling).
# Runtime authorization uses provisioned active D1 users and individual grants.
# This variable does not create or promote accounts during normal login.
# ADMIN_EMAILS=you@example.com

# Resend API key, used to deliver login OTP emails. Part of the AUTH_MODE
# fail-closed set. When unset, OTP codes are printed to the worker console and
# served from `/api/dev/otp`, so local Playwright tests can read them back.
#
# WARNING: that endpoint is gated only on "no RESEND_API_KEY and AUTH_MODE is
# not disabled" - there is no stage check. Because PR previews reuse `.dev.env`
# and skip the fail-closed validation, a `.dev.env` with AUTH_MODE=open but no
# Resend key will serve readable OTP codes on a public preview URL.
#
# Get: https://resend.com
# RESEND_API_KEY=

# Sender address for OTP emails. Part of the AUTH_MODE fail-closed set, on the
# same rule as the other three - NOT "only needed when RESEND_API_KEY is set".
#
# Must be a Resend-verified sender or domain. Left empty at runtime, the code
# falls back to Resend's sandbox sender.
# EMAIL_FROM=Your App <auth@yourdomain.com>

# ---------------------------------------------------------------------------
# R2 storage
# CASE_STORAGE_MODE=demo is for localhost synthetic case images only.
# dev:local supplies a private, persistent local CASE_BUCKET for case uploads.
# Case uploads use the Worker binding directly and need no S3 credentials.
# Private R2 case images use CASE_STORAGE_MODE=r2 and a separate CASE_BUCKET
# binding (no public domain). Leave unset until that binding is configured.
# CASE_STORAGE_MODE=
# ---------------------------------------------------------------------------

# R2 credentials for the storage routes (presigned uploads, list, delete).
#
# Optional, but the two keys must be set together - without both, the R2
# bindings are skipped and the storage routes return errors.
#
# Get: Cloudflare dashboard -> R2 -> Manage R2 API tokens -> Object Read & Write
# (the secret is shown only once, at creation time)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional server-only Telegram integration. dev:local uses the fake client.
# No bot registration or setWebhook call is performed by this project.
# TELEGRAM_MODE=disabled
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=replace-with-secret-placeholder
# BUSINESS_TIMEZONE=Asia/Taipei

# Server-only image transcription. Fake mode makes no external AI request.
# IMAGE_EXTRACTION_MODE=disabled
# OPENAI_API_KEY=replace-with-secret-placeholder
# OPENAI_IMAGE_MODEL=replace-with-image-model-name
# OPENAI_REQUEST_TIMEOUT_MS=10000
# OPENAI_MAX_RETRIES=3

# Commission rate for new payments, snapshotted into each settlement.
# Return split is snapshotted per collector; retired fee settings are not used.

# Bot 管理使用 32-byte Base64 AES-GCM master key，僅放 Worker Secret。
# 請保留金鑰的安全備份；遺失時需重新綁定 Bot Token。
# TELEGRAM_TOKEN_ENCRYPTION_KEY=

# Formal username/password/TOTP authentication. Email OTP is retired.
ACCOUNT_AUTH_MODE=managed
# Required on deployed Workers: cryptographically random AES-256 key (64 hex).
# Set via Worker Secret; never commit its value. Local uses an isolated derived key.
# ACCOUNT_TOTP_ENCRYPTION_KEY=
ACCOUNT_TOTP_KEY_VERSION=v1
# Optional JSON mapping of retained key versions, also a Worker Secret.
# ACCOUNT_TOTP_ENCRYPTION_KEYS=
