# apps/server/.local.env — local secrets only (gitignored).
# Same file structure applies to .dev.env / .prod.env (synced to GitHub Secrets
# via `pnpm sync:secrets`). See docs/environment.md.
#
# Topology (custom domains, project name) lives in config.ts at the repo root,
# NOT in env files. Cross-app URLs (CORS_ORIGIN, NEXT_PUBLIC_SERVER_URL) are
# auto-derived in alchemy.run.ts.

# Optional: R2 storage credentials. Without these, the storage playground
# routes return an error but the rest of the server works.
# Create an R2 token at: https://dash.cloudflare.com/?to=/:account/r2/overview
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
