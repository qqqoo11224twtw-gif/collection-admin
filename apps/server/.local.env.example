# apps/server/.local.env — local dev only (gitignored)
# Copy this file to .local.env and fill in values:
#   cp apps/server/.local.env.example apps/server/.local.env
#
# For deploys (.dev.env / .prod.env) the same variables apply, but those
# files are uploaded to GitHub Secrets via `pnpm sync:secrets`.
# See docs/environment.md for the full lifecycle.

# Required: comma-separated list of allowed CORS origins for the Hono server.
# Local dev defaults to the web dev server at :3000.
# (For .dev.env / .prod.env this is derived automatically from WEB_DOMAIN or
# the workers.dev URL — only set it manually for local dev or special cases.)
CORS_ORIGIN=http://localhost:3000

# Optional: custom domains for deploy stages. If set, the worker is bound to
# this domain (zone must be hosted on Cloudflare DNS). If unset, falls back to
# the auto-generated `*.workers.dev` URL.
# WEB_DOMAIN=app.example.com
# SERVER_DOMAIN=api.example.com

# Optional: R2 storage credentials. Without these, the storage playground
# routes return an error but the rest of the server works.
# Create an R2 token at: https://dash.cloudflare.com/?to=/:account/r2/overview
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
