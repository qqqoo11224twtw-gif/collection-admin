{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starter-server-offline",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "vars": {
    "CORS_ORIGIN": "http://localhost:3000",
    "SERVER_URL": "http://localhost:4000",
    "AUTH_MODE": "open",
    "BETTER_AUTH_SECRET": "local-dev-secret-not-for-prod",
    "ADMIN_EMAILS": "admin@example.test,phase2-admin@example.test,phase3-admin@example.test,phase4-admin@example.test,phase5-admin@example.test,phase6-admin@example.test,phase7-admin@example.test,phase8-admin@example.test",
    "RESEND_API_KEY": "",
    "EMAIL_FROM": "",
    "CASE_STORAGE_MODE": "demo",
    "TELEGRAM_MODE": "fake",
    "TELEGRAM_BOT_TOKEN": "",
    "TELEGRAM_WEBHOOK_SECRET": "local-simulator-placeholder",
    "BUSINESS_TIMEZONE": "Asia/Taipei",
    "IMAGE_EXTRACTION_MODE": "fake",
    "OPENAI_API_KEY": "",
    "OPENAI_IMAGE_MODEL": "",
    "OPENAI_REQUEST_TIMEOUT_MS": "10000",
    "OPENAI_MAX_RETRIES": "3",
    "COMMISSION_RATE": "0.50"
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-local-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local-kv" }],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "starter-local-bucket" },
    { "binding": "CASE_BUCKET", "bucket_name": "cases-private-local" }
  ]
}
