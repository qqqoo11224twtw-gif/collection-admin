# apps/web/.local.env — local dev only (gitignored)
# Copy this file to .local.env and fill in values:
#   cp apps/web/.local.env.example apps/web/.local.env
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle
# at build time by vite-plugin-environment (see apps/web/vite.config.ts).
# Do NOT put secrets behind this prefix — they will be visible in the browser.
#
# See docs/environment.md for the full env lifecycle (local / dev / prod).

# Required: backend ORPC server URL. The browser calls `${NEXT_PUBLIC_SERVER_URL}/rpc`.
# Local dev defaults to the Hono server on :4000.
# (For .dev.env / .prod.env this is derived automatically from config.ts
# domains or the workers.dev URL — only set it manually to override.)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Custom domains for deploy stages live in config.ts at the repo root,
# NOT in env files. See config.ts → domains.{dev,prod}.
