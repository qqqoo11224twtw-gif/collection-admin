{
  "name": "@saasflare-dev/starter",
  "saasflare": {
    "projectName": "starter",
    "displayName": "Saasflare Starter",
    "appId": "saasflare-starter",
    "apiKeyPrefix": "sfapp_"
  },
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "deploy:dev": "bash scripts/deploy.sh pnpm run -r deploy:dev",
    "deploy:prod": "bash scripts/deploy.sh pnpm run -r deploy:prod",
    "deploy:pr": "bash scripts/deploy.sh pnpm run -r deploy:pr",
    "destroy:dev": "bash scripts/deploy.sh pnpm run -r destroy:dev",
    "destroy:prod": "bash scripts/deploy.sh pnpm run -r destroy:prod",
    "destroy:pr": "bash scripts/deploy.sh pnpm run -r destroy:pr",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @saasflare-dev/web run test:e2e",
    "typecheck": "pnpm -r typecheck",
    "ci": "biome ci",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "sync:secrets": "bash scripts/sync-secrets.sh",
    "db:query": "node --env-file=.alchemy.env scripts/db-query.ts"
  },
  "description": "",
  "keywords": [],
  "author": "Saasflare",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "alchemy": "catalog:",
    "ctx7": "^0.3.9",
    "wrangler": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "patchedDependencies": {
      "alchemy": "patches/alchemy.patch"
    }
  }
}
