# .alchemy.env — control-plane secrets shared across all stages.
# Gitignored. Copy to .alchemy.env and fill in.
#
# scripts/deploy.sh auto-sources this file before every deploy/destroy,
# so child alchemy processes pick it up via the inherited shell env.
# CI workflows write the same content from the ENV_ALCHEMY secret.

CLOUDFLARE_API_TOKEN=        # pnpm dlx alchemy util create-cloudflare-token
CLOUDFLARE_EMAIL=            # your Cloudflare account email
ALCHEMY_STATE_TOKEN=         # openssl rand -hex 32
                             # MUST match across all saasflare projects
                             # on this CF account (it's the encryption
                             # key for alchemy's remote state store)
